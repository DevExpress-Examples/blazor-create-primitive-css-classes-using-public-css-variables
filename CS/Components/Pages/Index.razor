@page "/"
@rendermode InteractiveServer


<PageTitle>Primitive Classes</PageTitle>

<div class="main-content">

    <div class="card card-profile">

        <div class="card-header">

        <div class="row gap-160 align-start">

            <span class="avatar avatar-xlarge">
                <img src="images/avatars/Amelia_Harper.png" alt="Amelia Harper">
            </span>

            <div class="stack flex-grow gap-160">

                <div class="stack gap-40">
                    <div class="row flex-between name-row">
                        <h3 class="label-name">Amelia Harper</h3>
                        <DxButton RenderStyleMode="ButtonRenderStyleMode.Text" IconUrl="@Icon.EditPen" />
                    </div>

                    <span class="label-role">Engineer</span>
                </div>

                <div class="row buttons-row">
                    <DxDropDownButton Text="Call"
                                      IconUrl="@Icon.Phone"
                                      RenderStyle="ButtonRenderStyle.Primary">
                        <Items>
                            <DxDropDownButtonItem Text="Mobile" />
                            <DxDropDownButtonItem Text="Work" />
                        </Items>
                    </DxDropDownButton>

                    <DxButton RenderStyleMode="ButtonRenderStyleMode.Text"
                              IconUrl="@Icon.Mail" />

                    <DxButton RenderStyleMode="ButtonRenderStyleMode.Text"
                              IconUrl="@Icon.Chat" />
                </div>
            </div>
        </div>

        <DxTabs>
            <DxTabPage Text="Tasks"></DxTabPage>
            <DxTabPage Text="Evaluations"></DxTabPage>
        </DxTabs>

        </div>

        <div class="card-body">
                    <div class="card card-item">
                        <div class="row flex-between">
                            <span class="badge badge-success">Low</span>
                            <span class="badge">12/12/26</span>
                        </div>
                        <span class="label-title">Create 2020 R&amp;D Plans</span>
                        <p class="label-body">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        <DxProgressBar Value="30" LabelPosition="ProgressBarLabelPosition.Right" CssClass="card-progress" Size="100%" />
                    </div>

                    <div class="card card-item">
                        <div class="row flex-between">
                            <span class="badge badge-warning">Medium</span>
                            <span class="badge">12/12/26</span>
                        </div>
                        <span class="label-title">Create 2020 R&amp;D Plans</span>
                        <p class="label-body">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        <DxProgressBar Value="60" LabelPosition="ProgressBarLabelPosition.Right" CssClass="card-progress" Size="100%" />
                    </div>

                    <div class="card card-item">
                        <div class="row flex-between">
                            <span class="badge badge-danger">High</span>
                            <span class="badge">12/12/26</span>
                        </div>
                        <span class="label-title">Create 2020 R&amp;D Plans</span>
                        <p class="label-body">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        <DxProgressBar Value="95" LabelPosition="ProgressBarLabelPosition.Right" CssClass="card-progress" Size="100%" />
                    </div>
        </div>

    </div>

</div>

